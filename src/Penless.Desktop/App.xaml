<Application x:Class="Penless.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ══════════════════════════════════════════════════════════
             Windows 98 Classic Color Palette
        ══════════════════════════════════════════════════════════ -->
        <Color x:Key="Win98Gray">#C0C0C0</Color>
        <Color x:Key="Win98DarkGray">#808080</Color>
        <Color x:Key="Win98White">#FFFFFF</Color>
        <Color x:Key="Win98Black">#000000</Color>
        <Color x:Key="Win98TitleBar">#000080</Color>
        <Color x:Key="Win98TitleText">#FFFFFF</Color>
        <Color x:Key="Win98BtnHighlight">#FFFFFF</Color>
        <Color x:Key="Win98BtnShadow">#808080</Color>
        <Color x:Key="Win98BtnDarkShadow">#404040</Color>
        <Color x:Key="Win98BtnFace">#C0C0C0</Color>
        <Color x:Key="Win98TextBox">#FFFFFF</Color>
        <Color x:Key="Win98TextColor">#000000</Color>
        <Color x:Key="Win98SelectBlue">#000080</Color>
        <Color x:Key="Win98Green">#008000</Color>
        <Color x:Key="Win98Red">#800000</Color>

        <SolidColorBrush x:Key="BgDarkBrush"      Color="{StaticResource Win98Gray}" />
        <SolidColorBrush x:Key="BgCardBrush"       Color="{StaticResource Win98Gray}" />
        <SolidColorBrush x:Key="PrimaryBrush"      Color="{StaticResource Win98TitleBar}" />
        <SolidColorBrush x:Key="PrimaryDarkBrush"  Color="#000060" />
        <SolidColorBrush x:Key="SecondaryBrush"    Color="{StaticResource Win98SelectBlue}" />
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="{StaticResource Win98TextColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Win98DarkGray}" />
        <SolidColorBrush x:Key="SuccessBrush"      Color="{StaticResource Win98Green}" />
        <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource Win98Red}" />

        <!-- ══════════════════════════════════════════════════════════
             Win98 Raised Button (3D beveled look)
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background"   Value="#C0C0C0" />
            <Setter Property="Foreground"   Value="#000000" />
            <Setter Property="BorderBrush"  Value="#808080" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding"      Value="18,5" />
            <Setter Property="FontFamily"   Value="Tahoma, MS Sans Serif, Arial" />
            <Setter Property="FontSize"     Value="11" />
            <Setter Property="Cursor"       Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Outer border: dark shadow -->
                        <Border x:Name="outerBorder"
                                BorderBrush="#404040" BorderThickness="1"
                                Padding="1">
                            <!-- Inner border: highlight on top-left, shadow on bottom-right -->
                            <Border x:Name="innerBorder"
                                    Background="#C0C0C0"
                                    BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#808080" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter x:Name="cp"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="innerBorder" Property="Background" Value="#D4D0C8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <!-- Invert borders to simulate pressed -->
                                <Setter TargetName="innerBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#808080" Offset="0"/>
                                            <GradientStop Color="#FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="cp" Property="Margin" Value="1,1,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="innerBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (Stop) - same shape, red text -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="#800000" />
        </Style>

        <!-- Secondary Button (Browse / Clear) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             Win98 Sunken TextBox
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background"    Value="#FFFFFF" />
            <Setter Property="Foreground"    Value="#000000" />
            <Setter Property="CaretBrush"    Value="#000000" />
            <Setter Property="Padding"       Value="4,3" />
            <Setter Property="FontFamily"    Value="Tahoma, MS Sans Serif, Arial" />
            <Setter Property="FontSize"      Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Outer: dark border line -->
                        <Border BorderBrush="#404040" BorderThickness="1" Padding="1">
                            <!-- Inner: highlight on top-left (sunken effect) -->
                            <Border BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#808080" Offset="0"/>
                                        <GradientStop Color="#FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             Win98 Sunken PasswordBox
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"    Value="#FFFFFF" />
            <Setter Property="Foreground"    Value="#000000" />
            <Setter Property="CaretBrush"    Value="#000000" />
            <Setter Property="Padding"       Value="4,3" />
            <Setter Property="FontFamily"    Value="Tahoma, MS Sans Serif, Arial" />
            <Setter Property="FontSize"      Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border BorderBrush="#404040" BorderThickness="1" Padding="1">
                            <Border BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#808080" Offset="0"/>
                                        <GradientStop Color="#FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" />
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
